#!/bin/sh
# Bloqueia commits diretos em branches protegidas.
# Branches: git config hooks.protectedBranches (padrão: "main master").
# Bypass: ALLOW_MAIN=1 git commit ...  (ou git commit --no-verify)
#
# Também roda o gitleaks nas mudanças staged, se estiver instalado
# (ALLOW_MAIN não pula essa checagem; só --no-verify pula).

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner --verbose --log-level warn --exit-code 1 >&2; then
    cat >&2 <<MSG
✖ Commit bloqueado: o gitleaks encontrou possível segredo nas mudanças staged.
  Remova o segredo (e rotacione-o se já foi exposto).
  Falso positivo: adicione o fingerprint em .gitleaksignore.
MSG
    exit 1
  fi
fi

[ "${ALLOW_MAIN:-}" = "1" ] && exit 0

branch=$(git symbolic-ref --short -q HEAD) || exit 0  # detached HEAD: deixa passar

protected=$(git config --get hooks.protectedBranches | tr ',' ' ')
[ -n "$protected" ] || protected="main master"

for p in $protected; do
  if [ "$branch" = "$p" ]; then
    cat >&2 <<MSG
✖ Commit bloqueado: a branch '$branch' é protegida.
  Crie uma branch de trabalho:  git switch -c feat/<nome>
  Para ignorar conscientemente: ALLOW_MAIN=1 git commit ...
MSG
    exit 1
  fi
done
exit 0
