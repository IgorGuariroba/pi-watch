#!/bin/sh
# Bloqueia push (inclusive delete e refspec src:dst) para branches protegidas.
# stdin: <local ref> <local sha> <remote ref> <remote sha>
# Branches: git config hooks.protectedBranches (padrão: "main master").
# Bypass: ALLOW_MAIN=1 git push ...  (ou git push --no-verify)

[ "${ALLOW_MAIN:-}" = "1" ] && exit 0

protected=$(git config --get hooks.protectedBranches | tr ',' ' ')
[ -n "$protected" ] || protected="main master"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  for p in $protected; do
    if [ "$remote_ref" = "refs/heads/$p" ]; then
      cat >&2 <<MSG
✖ Push bloqueado: '$local_ref' → '$remote_ref' ($1). A branch '$p' é protegida.
  Crie uma branch de trabalho:  git switch -c feat/<nome>
  e abra um PR. Para ignorar conscientemente: ALLOW_MAIN=1 git push ...
MSG
      status=1
    fi
  done
done
exit $status
